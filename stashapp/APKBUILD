pkgname=stash
pkgver=0.32.0
pkgrel=0
pkgdesc="An organizer for your porn, written in Go"
url="https://github.com/stashapp/stash"
arch="x86_64"
license="AGPL-3.0-only"
depends="ca-certificates ffmpeg tzdata vips vips-tools"
makedepends="py3-pip python3"
options="!check !strip"

subpackages="$pkgname-openrc::x86_64 $pkgname-python::x86_64"

install="$pkgname.pre-install"

_mechanicalsoup_ver=1.4.0
_cloudscraper_ver=1.2.71
_stashapptools_ver=0.2.59
_pypi=https://files.pythonhosted.org/packages

source="
      stash-linux-$pkgver::https://github.com/stashapp/stash/releases/download/v$pkgver/stash-linux
      $_pypi/py3/m/mechanicalsoup/mechanicalsoup-$_mechanicalsoup_ver-py3-none-any.whl
      $_pypi/py2.py3/c/cloudscraper/cloudscraper-$_cloudscraper_ver-py2.py3-none-any.whl
      $_pypi/py3/s/stashapp-tools/stashapp_tools-$_stashapptools_ver-py3-none-any.whl
      stash.initd
      stash.confd
      "

pkgusers="stash"
pkggroups="stash"

package() {
	install -dm755 "$pkgdir/var/lib/stash"
	install -dm755 "$pkgdir/var/log/stash"

	install -Dm755 "$srcdir"/stash-linux-$pkgver "$pkgdir"/usr/bin/stash
	install -Dm755 "$srcdir"/$pkgname.initd "$pkgdir"/etc/init.d/$pkgname
	install -Dm644 "$srcdir"/$pkgname.confd "$pkgdir"/etc/conf.d/$pkgname
}

python() {
    pkgdesc="Python runtime and pip for $pkgname plugins"
	depends="python3 py3-pip py3-requests py3-requests-toolbelt py3-lxml py3-beautifulsoup4 py3-urllib3 py3-certifi py3-parsing"

    python3 -m pip install \
        --root="$subpkgdir" --prefix=/usr \
        --no-deps \
        --no-index \
        --no-cache-dir \
        --disable-pip-version-check \
        --break-system-packages \
        "$srcdir"/*.whl
}
