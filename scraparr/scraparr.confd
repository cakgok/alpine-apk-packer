# /etc/conf.d/scraparr
# Sourced by /etc/init.d/scraparr.
# Scraparr is configured through environment variables.
# At least one connector (<SERVICE>_URL + <SERVICE>_API_KEY) is required.
command_user="scraparr:scraparr"

# --- General (optional) ---
# export GENERAL_ADDRESS=0.0.0.0
# export GENERAL_PORT=7100
# export GENERAL_PATH=/metrics
# export GENERAL_WORKERS=5
# export GENERAL_LOG_LEVEL=INFO    # DEBUG, INFO, WARNING, ERROR, CRITICAL

# --- Auth (optional) ---
# export AUTH_USERNAME=user
# export AUTH_PASSWORD=pass
# export AUTH_TOKEN=token

# Any secret can be read from a file instead by appending _FILE, e.g.
# export SONARR_API_KEY_FILE=/etc/scraparr/sonarr_api_key

# Every connector also accepts these optional fields:
#   <SERVICE>_ALIAS, <SERVICE>_API_VERSION, <SERVICE>_INTERVAL (seconds),
#   <SERVICE>_DETAILED (true/false)

# --- Sonarr ---
# export SONARR_URL=http://localhost:8989
# export SONARR_API_KEY=key
# export SONARR_EPISODE_QUALITY_STATS=true

# --- Radarr ---
# export RADARR_URL=http://localhost:7878
# export RADARR_API_KEY=key

# --- Prowlarr ---
# export PROWLARR_URL=http://localhost:9696
# export PROWLARR_API_KEY=key

# --- Bazarr ---
# export BAZARR_URL=http://localhost:6767
# export BAZARR_API_KEY=key

# --- Readarr ---
# export READARR_URL=http://localhost:8787
# export READARR_API_KEY=key

# --- Lidarr ---
# export LIDARR_URL=http://localhost:8686
# export LIDARR_API_KEY=key

# --- Whisparr ---
# export WHISPARR_URL=http://localhost:6969
# export WHISPARR_API_KEY=key

# --- Sportarr ---
# export SPORTARR_URL=http://localhost:PORT
# export SPORTARR_API_KEY=key

# --- Seerr ---
# export SEERR_URL=http://localhost:5055
# export SEERR_API_KEY=key

# --- Jellyfin ---
# export JELLYFIN_URL=http://localhost:8096
# export JELLYFIN_API_KEY=key
# export JELLYFIN_WITHIN=300
# export JELLYFIN_SESSION_DETAILS=false
# export JELLYFIN_CLIENT_INFO=false

# --- Kavita ---
# export KAVITA_URL=http://localhost:5000
# export KAVITA_API_KEY=key
# export KAVITA_LEGACY_AUTH=false

# --- Komga ---
# export KOMGA_URL=http://localhost:25600
# export KOMGA_API_KEY=key

# --- SABnzbd ---
# export SABNZBD_URL=http://localhost:8080
# export SABNZBD_API_KEY=key

# --- Multiple instances of one service: put an alias between name and field ---
# export SONARR_MAIN_URL=http://localhost:8989
# export SONARR_MAIN_API_KEY=key
# export SONARR_ANIME_URL=http://localhost:8990
# export SONARR_ANIME_API_KEY=key
