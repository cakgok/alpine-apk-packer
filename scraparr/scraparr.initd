#!/sbin/openrc-run
# /etc/init.d/scraparr

name="Scraparr"
description="Scraparr Daemon"

output_logger="logger -t scraparr -p daemon.info"
error_logger="logger -t scraparr -p daemon.err"

command_user="${command_user:-scraparr:scraparr}"

supervisor="supervise-daemon"
command="/usr/bin/scraparr"
respawn_delay=5
respawn_max=10

depend() {
    need net
    use logger
    after firewall
}
