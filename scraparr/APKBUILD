pkgname=scraparr
pkgver=3.2.0
pkgrel=0
pkgdesc="Prometheus exporter for the *arr suite"
url="https://github.com/thecfu/scraparr"
arch="x86_64"
license="GPL-3.0-only AND Apache-2.0"
depends="
  python3
  py3-requests
  py3-werkzeug
  py3-dateutil
  py3-yaml
  py3-dotenv
"
checkdepends="
  py3-pytest
  py3-pytest-mock
"

pkgusers="scraparr"
pkggroups="scraparr"
subpackages="$pkgname-openrc::x86_64"
install="$pkgname.pre-install"

# scraparr calls Gauge.remove_by_labels(), which needs prometheus_client >= 0.24.1.
# Alpine ships 0.20.0, so bundle a private copy until this merges and reaches edge:
# https://gitlab.alpinelinux.org/alpine/aports/-/merge_requests/110828
_promver=0.26.0

source="$pkgname-$pkgver.zip::https://github.com/thecfu/scraparr/archive/refs/tags/v$pkgver.zip
  prometheus_client-$_promver.tar.gz::https://files.pythonhosted.org/packages/source/p/prometheus_client/prometheus_client-$_promver.tar.gz
  scraparr.confd
  scraparr.initd
  scraparr.wrapper
  scraparr.pre-install
"

check() {
    PYTHONPATH="$srcdir/prometheus_client-$_promver" \
        python3 -m pytest -q -p no:cacheprovider
}

package() {
    install -dm755 "$pkgdir/usr/lib/scraparr"

    cp -a "$builddir"/src/. "$pkgdir/usr/lib/scraparr/"

    # the wrapper runs from /usr/lib/scraparr, so this copy wins over any system one
    cp -a "$srcdir/prometheus_client-$_promver/prometheus_client" "$pkgdir/usr/lib/scraparr/"
    install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname/prometheus_client" \
        "$srcdir/prometheus_client-$_promver/LICENSE" \
        "$srcdir/prometheus_client-$_promver/NOTICE"

    install -Dm755 "$srcdir"/$pkgname.wrapper "$pkgdir"/usr/bin/$pkgname
    install -Dm755 "$srcdir"/$pkgname.initd "$pkgdir"/etc/init.d/$pkgname
    # root-only: this file holds API keys
    install -Dm600 "$srcdir"/$pkgname.confd "$pkgdir"/etc/conf.d/$pkgname
}

